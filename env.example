# ===========================================
# 基本設定
# ===========================================
ENVIRONMENT=development
DEBUG=true

# APIサーバーのポート（省略時: 3001）
API_PORT=3001

# ===========================================
# Database (必須)
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yukkuri_movie_maker?schema=public

# ===========================================
# 生成AI API（利用するモデルの提供元だけ設定）
# ===========================================
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# AIVIS Speech (音声合成用・ローカルサーバー)
# 事前に AivisSpeech を起動しておくこと（標準パスは %LOCALAPPDATA%\Programs\AivisSpeech）
# ===========================================
AIVIS_SPEECH_BASE_URL=http://127.0.0.1:10101

# ===========================================
# その他のAPI (任意)
# ===========================================
STABILITY_API_KEY=your_stability_api_key_here

# YouTube投稿・分析を使う場合のみ。長期運用では更新トークン方式を推奨。
YOUTUBE_CLIENT_ID=your_google_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_oauth_refresh_token_here
# 後方互換用。短期間で失効するため常時運用では更新トークンを使う。
YOUTUBE_ACCESS_TOKEN=your_youtube_oauth_access_token_here
YOUTUBE_PRIVACY_STATUS=private
# ISO 8601日時を指定した場合はprivate + publishAtで予約公開する。
YOUTUBE_PUBLISH_AT=
# 認証・クォータ制約時に投稿台帳と分析をモックで継続する。falseで停止可能。
YMM_YOUTUBE_MOCK_ON_MISSING=true
# Workerが自動運用設定を確認する間隔（ミリ秒）。
YMM_AUTOMATION_POLL_INTERVAL_MS=60000
