{
  "name": "yukkuri_movie_maker_remotion",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/devWithLogging.mjs",
    "lint": "eslint .",
    "format": "prettier -w .",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test": "vitest run",
    "test:real": "vitest run -c vitest.real.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:journey": "playwright test e2e/customerJourney.spec.ts",
    "test:e2e:visual": "node scripts/runCustomerJourneyVisual.mjs",
    "test:e2e:visual:update": "node scripts/runCustomerJourneyVisual.mjs --update",
    "test:e2e:visual:check": "node scripts/visualRegression.mjs",
    "test:e2e:real:preflight": "node scripts/checkRealE2ePrereqs.mjs",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "test:e2e:report": "playwright show-report outputs/test_evidence/playwright/html-report",
    "check:script-llm": "node scripts/checkScriptGenerationLlm.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:up": "docker compose -f docker-compose.e2e.yml up -d",
    "db:down": "docker compose -f docker-compose.e2e.yml down",
    "cli": "corepack pnpm -C apps/cli start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.59.1",
    "@prisma/client": "6.19.3",
    "@types/node": "^22.10.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.1.0",
    "dotenv": "16.4.7",
    "eslint": "^9.39.2",
    "globals": "^17.7.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "fastify@<=5.7.2": ">=5.7.3",
      "webpack@>=5.49.0 <=5.104.0": ">=5.104.1",
      "webpack@>=5.49.0 <5.104.0": ">=5.104.0",
      "minimatch@<3.1.3": ">=3.1.3",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@<3.1.4": ">=3.1.4",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "fastify@>=5.7.2 <=5.8.0": ">=5.8.1",
      "flatted@<3.4.0": ">=3.4.0",
      "effect@<3.20.0": ">=3.20.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "fastify@<=5.8.2": ">=5.8.3",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "defu@<=6.1.4": ">=6.1.5",
      "postcss@<8.5.10": ">=8.5.10",
      "fastify@>=5.3.2 <=5.8.4": ">=5.8.5",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "serialize-javascript@>=5.0.0 <7.0.5": ">=7.0.5",
      "uuid@<11.1.1": ">=11.1.1",
      "vitest@<3.2.6": ">=3.2.6",
      "shell-quote@>=1.1.0 <=1.8.3": ">=1.8.4",
      "@babel/core@<=7.29.0": "7.29.6",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  }
}
